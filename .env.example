# ==============================================================================
# AnnaDrishti — Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key for Multimodal Vision OCR
# Get a free key at: https://aistudio.google.com/
# Note: If this key is not configured, AnnaDrishti automatically activates
# high-fidelity Demo Mode with verified packaging datasets (no crash or block).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: Port configuration (default: 3000)
PORT=3000
